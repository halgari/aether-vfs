{
  // The emit half of the migration: `index.mts`, `native.mts` and
  // `provider-host.mts` in, `index.mjs`, `index.d.mts`, `native.mjs`,
  // `native.d.mts` and `provider-host.mjs` out, all beside their sources.
  //
  // **`index.d.mts` is a build output.** That has been true since the TypeScript
  // migration's task 2, which stopped a hand-written `index.d.ts` and a
  // hand-written `index.cjs` from having to agree by discipline; they did not.
  // `native.mts` is the one declaration still written rather than derived,
  // because it describes a Rust binary — see its header, and
  // `scripts/check-types.mts` for what watches it.
  //
  // Separate from `tsconfig.json` for two reasons: that one has `noEmit` and a
  // wider `include` (the `.mts` scripts node runs directly, and the vitest
  // harness), and mixing "what to typecheck" with "what to compile" in one file
  // means either emitting the harness or not checking it.
  //
  // `outDir` is deliberately absent. The sources sit beside their outputs, which
  // works only because `.mts` and `.mjs` are different extensions — and it keeps
  // `import.meta.dirname` meaning the same directory in the source and in the
  // emitted file, which matters: `index.mts` hands it to Rust as the place to
  // look for the shim DLLs, and `native.mts` looks for `aethervfs.node` there.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // Off here, on in `tsconfig.json`. This config emits, and a `.cts`/`.mts`
    // import specifier is one `tsc` cannot rewrite for the emitted file; `test/`
    // and `examples/` are never emitted, so there such a specifier is the real
    // runtime one. Nothing in the three sources below imports a `.cts` or `.mts`
    // path, so this is a guard rather than a workaround: it keeps the emitting
    // config from inheriting a permission it must not have.
    "allowImportingTsExtensions": false,
    // Nothing generates these and shipping them would put source paths in the
    // tarball.
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["index.mts", "native.mts", "provider-host.mts"],
  "exclude": ["node_modules", "fixtures"]
}
