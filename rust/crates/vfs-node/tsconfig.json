{
  // The typecheck gate. `tsconfig.build.json` is the one that emits; this one
  // has `noEmit` and a wider `include`, so `tsc --noEmit` covers the files that
  // are typechecked but never compiled — the two `.mts` scripts node runs
  // through its own type stripping, and the vitest harness.
  //
  // ## What `include` covers, and what it does not yet
  //
  // Task 2 converted the package's own implementation, so `include` grew from
  // three files to eight. It is still **not** pointed at `test/**/*.cts` or
  // `examples/**/*.cts`, where it reports 135 errors that are not findings:
  //
  //   * **134 x TS2775** "Assertions require every name in the call target to be
  //     declared with an explicit type annotation." Every one comes from
  //     `const assert = require('node:assert') as typeof import('node:assert')`.
  //     `assert.ok` is an assertion function, and TypeScript requires the *name*
  //     it is called on to carry an explicit type annotation — an `as` cast is not
  //     one. The suites use that idiom because they run under node's type
  //     stripping in CommonJS, where `import` would not survive. Task 3 replaces
  //     it with a real `import`, and all 134 go away without a single assertion
  //     changing.
  //   * **1 x TS2322** at `examples/spec-8-example.cts:113` — an arrow annotated
  //     `: void` whose concise body returns `process.stdout.write`'s `boolean`.
  //     Cosmetic; the code is correct. Checked, because a lone error among 134 of
  //     one kind is where a real bug would hide.
  //
  // Widening `include` now would mean committing a red gate or loosening `strict`
  // to hide it. **Task 3 widens this to `test/**` and `examples/**`** once those
  // files are converted, and that widening is the check that the conversion landed.
  "compilerOptions": {
    // `nodenext` is what understands `.cts`/`.mts` and their emit: a `.cts` is
    // CommonJS and compiles to `index.cjs` + `index.d.cts`, which is exactly the
    // pair `package.json`'s `main` and `types` name. An `.mts` is ESM, which is
    // what node's type stripping needs to run a script file directly — a `.cts`
    // with `import` statements is a syntax error at runtime, verified rather than
    // assumed.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // The remaining `.cjs` files — the test helpers and the examples — are
    // untyped on purpose until task 3.
    "allowJs": false,
    "checkJs": false,

    "noEmit": true
  },
  "include": [
    "index.cts",
    "native.cts",
    "provider-host.cts",
    "scripts/build.mts",
    "scripts/check-types.mts",
    "vitest.config.ts",
    "vitest-setup.ts"
  ],
  // The build outputs. Excluded so a stale `index.d.cts` in the tree can never be
  // typechecked in place of the source it was emitted from.
  "exclude": ["node_modules", "fixtures", "**/*.d.cts", "**/*.cjs"]
}
