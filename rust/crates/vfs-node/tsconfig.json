{
  // The typecheck gate. `tsconfig.build.json` is the one that emits; this one
  // has `noEmit` and a wider `include`, so `tsc --noEmit` covers the files that
  // are typechecked but never compiled — the two `.mts` scripts node runs
  // through its own type stripping, the vitest config, the test suites and the
  // examples.
  //
  // ## `include` now covers the whole package, and that is the gate
  //
  // Task 1 scoped this to three files and recorded why: pointed at `test/**` and
  // `examples/**` it reported **135 errors**, 134 of them one TS2775 —
  // *"Assertions require every name in the call target to be declared with an
  // explicit type annotation"* — every one from
  // `const assert = require('node:assert') as typeof import('node:assert')`. A
  // cast is not an annotation, and an assertion function needs an annotation on
  // the name it is called on. The 135th was a cosmetic TS2322 in
  // `spec-8-example.cts`.
  //
  // Task 3 converted both directories and this `include` grew to cover them, which
  // is the check that the conversion landed. The suites are `import`ed by vitest
  // and use real `import` statements; the files node loads directly — the examples,
  // the provider fixtures and the worker entry point — keep `require` with a type
  // **annotation**, because node's type stripping erases annotations but does not
  // rewrite module syntax. Both forms satisfy TS2775; only the cast did not.
  "compilerOptions": {
    // `nodenext` is what understands `.cts`/`.mts` and their emit: a `.cts` is
    // CommonJS and compiles to `index.cjs` + `index.d.cts`, which is exactly the
    // pair `package.json`'s `main` and `types` name. An `.mts` is ESM, which is
    // what node's type stripping needs to run a script file directly — a `.cts`
    // with `import` statements is a syntax error at runtime, verified rather than
    // assumed.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Nothing under `test/` or `examples/` is ever compiled: node and vitest read
    // the `.cts` sources directly, so `./teardown.cts` **is** the runtime
    // specifier and not a stand-in for an emitted `.cjs`. `tsconfig.build.json`
    // turns this back off, because that config emits and there a `.cts`
    // specifier would be one `tsc` could not rewrite.
    "allowImportingTsExtensions": true,

    // No JavaScript is typechecked, because none is authored any more: every
    // `.cjs` in this package is a build output.
    "allowJs": false,
    "checkJs": false,

    "noEmit": true
  },
  "include": [
    "index.cts",
    "native.cts",
    "provider-host.cts",
    "scripts/build.mts",
    "scripts/check-types.mts",
    "vitest.config.ts",
    "bench/**/*.mts",
    "test/**/*.cts",
    "examples/**/*.cts"
  ],
  // The build outputs. Excluded so a stale `index.d.cts` in the tree can never be
  // typechecked in place of the source it was emitted from.
  "exclude": ["node_modules", "fixtures", "**/*.d.cts", "**/*.cjs"]
}
