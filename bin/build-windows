#!/usr/bin/env bash
# Cross-build the Windows half of the Proton path from Linux: the injector, the
# shim DLL, the payload DLL, the read fixture, the Steam probe, the NVAPI
# probe and the registry probe. They run inside Wine; the Director that serves
# them is native Linux and is built by plain `cargo`.
#
# The artifacts are copied beside the Linux binaries in target/<profile>/,
# which is where `Session::launch` (and the proton_launch e2e test) looks for
# them by default.
#
# Needs: rustup target x86_64-pc-windows-msvc, cargo-xwin, clang, lld, llvm.
# The first run downloads the MSVC CRT and Windows SDK into ~/.cache/cargo-xwin
# (XWIN_ACCEPT_LICENSE=1 accepts Microsoft's license for that download).
#
# The artefacts are the ones the Proton tests and `Session::launch` look for.
# Their one list in Rust is `vfs_proton::artifacts::WINDOWS_ARTIFACTS`; the
# ARTIFACTS array below must equal it (a vfs-proton test asserts that). Keep
# the cargo -p list below in step with it by hand.
#
# Usage: bin/build-windows [--release] [-h|--help]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/build-windows [--release]

Cross-builds the Windows half of the Proton path with cargo-xwin and copies
the artefacts into rust/target/<profile>/ (debug by default).

  --release   build with the release profile
  -h, --help  show this help

Needs: rustup target x86_64-pc-windows-msvc, cargo-xwin, clang, lld, llvm.
EOF
}

die() {
  echo "build-windows: $*" >&2
  exit 1
}

profile=debug
flags=()
for arg in "$@"; do
  case "$arg" in
    --release)
      profile=release
      flags=(--release)
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown argument: $arg"
      ;;
  esac
done

# Check the toolchain up front, so a missing tool is named here rather than
# surfacing as an opaque failure deep inside cargo.
command -v cargo > /dev/null || die "cargo not found (install Rust via rustup)"
cargo xwin --version > /dev/null 2>&1 \
  || die "cargo-xwin not found (cargo install --locked cargo-xwin)"
command -v rustup > /dev/null || die "rustup not found (needed for the Windows target)"
rustup target list --installed 2> /dev/null | grep -qx 'x86_64-pc-windows-msvc' \
  || die "rust target missing (rustup target add x86_64-pc-windows-msvc)"
for tool in clang lld-link; do
  command -v "$tool" > /dev/null || die "$tool not found (install clang, lld and llvm)"
done

cd "$(dirname "$0")/../rust"

target=x86_64-pc-windows-msvc
ARTIFACTS=(
  vfs-injector.exe
  vfs_shim_dll.dll
  vfs_payload.dll
  vfs-fixture-read.exe
  vfs-fixture-steam.exe
  vfs-fixture-nvapi.exe
  vfs-fixture-registry.exe
)

export XWIN_ACCEPT_LICENSE=1

# `libudis86-sys` (reached through `retour`, i.e. the shim) calls `memset`
# without including string.h and papers over it with the GCC-only flag
# `-includestring.h`. cl.exe tolerates the implicit declaration; clang-cl drops
# the unknown flag and then rejects it as an error. Demote that one diagnostic
# back to a warning. A forced include (`/FIstring.h`) is *not* a substitute: it
# reaches every C compile for the target, including blake3's preprocessed
# assembly, which it breaks.
#
# Set here rather than in .cargo/config.toml so a native Windows build — real
# cl.exe, which would warn about the unknown flag — never sees it. The hyphenated
# name is deliberate: cargo-xwin sets the underscored
# `CFLAGS_x86_64_pc_windows_msvc` itself, and cc-rs reads both.
# Bash cannot export a hyphenated name, so it goes in through `env`.
cross=(env "CFLAGS_x86_64-pc-windows-msvc=-Wno-error=implicit-function-declaration")
"${cross[@]}" cargo xwin build "${flags[@]}" --target "$target" \
  -p vfs-inject -p vfs-shim-dll -p vfs-fixture-read -p vfs-fixture-steam \
  -p vfs-fixture-nvapi -p vfs-fixture-registry
# vfs-payload is its own workspace (panic=abort, no CRT), so it builds apart.
"${cross[@]}" cargo xwin build "${flags[@]}" --target "$target" \
  --manifest-path crates/vfs-payload/Cargo.toml --target-dir target

src="target/$target/$profile"
dst="target/$profile"
mkdir -p "$dst"
for f in "${ARTIFACTS[@]}"; do
  [[ -f "$src/$f" ]] || die "the build succeeded but did not produce $src/$f"
  cp -f "$src/$f" "$dst/$f"
  echo "  $dst/$f"
done
